# Blockscout (v12.0.3, CHAIN_TYPE=arbitrum, built from source) settings for Elysium mainnet 99901.
# Secrets (DATABASE_URL, SECRET_KEY_BASE) are in secrets.env (chmod 600), not here.

# --- chain + node -------------------------------------------------------------------------------
CHAIN_ID=99901
# Nitro speaks geth's JSON-RPC incl. debug_traceBlockByNumber with callTracer.
ETHEREUM_JSONRPC_VARIANT=geth
ETHEREUM_JSONRPC_TRANSPORT=http
ETHEREUM_JSONRPC_HTTP_URL=http://explorer-node:8547/
ETHEREUM_JSONRPC_TRACE_URL=http://explorer-node:8547/
ETHEREUM_JSONRPC_WS_URL=ws://explorer-node:8546/
ETHEREUM_JSONRPC_GETH_TRACE_BY_BLOCK=true
INDEXER_INTERNAL_TRANSACTIONS_TRACER_TYPE=call_tracer
# Nitro has no public mempool: transactions go straight to the Conduit sequencer.
INDEXER_DISABLE_PENDING_TRANSACTIONS_FETCHER=true

# --- native coin + market -----------------------------------------------------------------------
# Elysium pays gas in HYPE. Price/market cap come from CoinGecko's public API (no key).
COIN=HYPE
COIN_NAME=HYPE
DISABLE_MARKET=false
MARKET_COINGECKO_COIN_ID=hyperliquid

# --- web/API ------------------------------------------------------------------------------------
PORT=4000
API_V2_ENABLED=true
# The API listens on 127.0.0.1 only and its one caller is our own web server, which would trip per-IP limits.
# Revisit before anything other than our web server can reach it.
API_RATE_LIMIT_DISABLED=true
ACCOUNT_ENABLED=false
# v12 reads ECTO_SSL_MODE (default "require"; ECTO_USE_SSL is gone). The DB is on the compose network only.
ECTO_SSL_MODE=disable
DISABLE_FILE_LOGGING=true

# --- contract verification ------------------------------------------------------------------------
# Blockscout's public eth-bytecode-db service compiles submitted sources (sources being verified are public anyway).
MICROSERVICE_SC_VERIFIER_ENABLED=true
MICROSERVICE_SC_VERIFIER_TYPE=eth_bytecode_db
MICROSERVICE_SC_VERIFIER_URL=https://eth-bytecode-db.services.blockscout.com/

# --- ENS names (what Etherscan shows as "vitalik.eth" in place of 0xd8dA...) -----------------------
# Elysium wallets are the same keys as on Ethereum, so their ENS primary names apply here too. Blockscout's
# public BENS service resolves them; "multiprotocol" mode (PROTOCOLS set) asks by protocol id instead of by
# our CHAIN_ID, which BENS does not know. Only public addresses are sent. Search by "name.eth" works too.
MICROSERVICE_BENS_ENABLED=true
MICROSERVICE_BENS_URL=https://bens.services.blockscout.com
MICROSERVICE_BENS_PROTOCOLS=ens

# --- decoding calls of unverified contracts (Etherscan's "Function: approve(address spender, ...)") -
# Almost nothing on Elysium is verified, so without this the tx page shows raw input. Blockscout asks its public
# sig-provider only on a single tx page and for its logs; lists name methods in the web app (web/lib/methods.ts).
# Only public calldata and log topics are sent.
MICROSERVICE_SIG_PROVIDER_ENABLED=true
MICROSERVICE_SIG_PROVIDER_URL=https://sig-provider.services.blockscout.com

# --- Arbitrum-specific trackers (parent chain = HyperEVM) -------------------------------------------
# Enabled 2026-11-01 (owner's go-ahead) so deposits/withdrawals show their HyperEVM side and blocks their batch.
# Batches: SequencerInbox posts (seen format 0x69cacded, addSequencerL2BatchFromOriginDelayProof, which v12 decodes),
# their confirmations (Outbox SendRootUpdated, the same for this BoLD rollup) and withdrawal executions on the Outbox.
# Bridge messages: deposits found on the Bridge and matched to their Elysium transactions.
INDEXER_ARBITRUM_BATCHES_TRACKING_ENABLED=true
INDEXER_ARBITRUM_BRIDGE_MESSAGES_TRACKING_ENABLED=true
# HyperEVM through the node's own sticky-failover proxy (compose network), so no provider URL or key is set here.
# Checked through it on 2026-11-01: chain id 999, "safe"/"finalized" tags, eth_getLogs over 1,000 blocks back to the
# rollup's deployment. Its JSON-RPC batch size stays at 20 (rpc.hypurrscan.io refuses larger batches).
# /plain skips the proxy's header prefetch (meant for nitro): on the root path every eth_getLogs answer here set off
# hundreds of header fetches and drove all providers into HTTP 429 within 4 minutes (2026-11-01 03:47).
INDEXER_ARBITRUM_L1_RPC=http://explorer-parent-proxy:8545/plain
INDEXER_ARBITRUM_L1_RPC_CHUNK_SIZE=20
INDEXER_ARBITRUM_L1_RPC_HISTORICAL_BLOCKS_RANGE=1000
# From node/config/chainInfo.json (rollup.rollup, rollup.deployed-at). Bridge, SequencerInbox and Outbox are read
# from the rollup contract itself. Start block 0: begin at HyperEVM's safe block and walk history back to deployment.
INDEXER_ARBITRUM_L1_ROLLUP_CONTRACT=0x508C173dFe5F737B3493195Bf785d71fA76fD217
INDEXER_ARBITRUM_L1_ROLLUP_INIT_BLOCK=48956737
INDEXER_ARBITRUM_L1_COMMON_START_BLOCK=0
