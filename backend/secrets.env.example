# Local-only secrets for the Blockscout backend. Copy to `backend/secrets.env` and generate YOUR OWN values.
# These are per-deployment; never reuse someone else's and never commit the real file (it is git-ignored).
#
# Generate fresh values:
#   POSTGRES_PASSWORD :  openssl rand -hex 24
#   SECRET_KEY_BASE   :  openssl rand -hex 32
#   DATABASE_URL      :  embed the SAME POSTGRES_PASSWORD below, pointing at the db service.

POSTGRES_PASSWORD=REPLACE-WITH-openssl-rand-hex-24
DATABASE_URL=postgresql://blockscout:REPLACE-WITH-THE-SAME-POSTGRES_PASSWORD@explorer-db:5432/blockscout
SECRET_KEY_BASE=REPLACE-WITH-openssl-rand-hex-32
