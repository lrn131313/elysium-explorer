# Elysium Explorer — node settings. Copy to `node/.env` and fill in YOUR OWN endpoints.
# The node will not start until the three endpoints below are set.

# The node reads the parent chain through the proxy container (not directly).
PARENT_CHAIN_RPC=http://explorer-parent-proxy:8545

# archive = keep all historical state (needed for the explorer's internal-transaction traces).
# full = lighter, no historical state.
NODE_MODE=archive
RPC_API=net,web3,eth,debug
PARENT_CHAIN_MAX_BLOCKS_TO_READ=1000

# >>> YOUR Elysium endpoints. Use your own node/provider — do NOT reuse anyone else's. <<<
# Where the node forwards L2 transactions and where it pulls new blocks / data from:
FORWARDING_TARGET=https://REPLACE-WITH-YOUR-ELYSIUM-SEQUENCER-RPC
SEQUENCER_FEED_RELAY=wss://REPLACE-WITH-YOUR-ELYSIUM-SEQUENCER-FEED/
DAS_URL=https://REPLACE-WITH-YOUR-ELYSIUM-DAS
