# docker-compose variables for the explorer stack. Copy to `.env` and fill in YOUR OWN values.

# The parent-proxy load-balances over these parent-chain (HyperEVM) RPC endpoints.
# Use your own — comma-separated, no spaces. One indexing style only; see node/.env.example.
PARENT_UPSTREAMS=https://REPLACE-WITH-YOUR-HYPEREVM-RPC-1,https://REPLACE-WITH-YOUR-HYPEREVM-RPC-2
